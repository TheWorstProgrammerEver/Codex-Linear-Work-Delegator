# Safe defaults. Put secrets in .env.local or a systemd EnvironmentFile.

# Authentication defaults to auto: complete OAuth client credentials are
# preferred, with LINEAR_API_KEY retained as an optional fallback.
CODEX_LINEAR_AUTH_MODE=auto
CODEX_LINEAR_OAUTH_TOKEN_URL=https://api.linear.app/oauth/token
CODEX_LINEAR_OAUTH_SCOPES=read,write
CODEX_LINEAR_API_URL=https://api.linear.app/graphql
# Durable agent identity for named Linear pickup labels; not necessarily the Unix user.
CODEX_LINEAR_AGENT_ID=my-agent
CODEX_LINEAR_AGENT_LABELS=agent:any

CODEX_LINEAR_READY_STATUS=Waiting For Agent
CODEX_LINEAR_RUNNING_STATUS=Agent In Progress
CODEX_LINEAR_BLOCKED_STATUS=Blocked
CODEX_LINEAR_REVIEW_STATUS=In Review
CODEX_LINEAR_REVIEW_RUNNING_STATUS=Agent Reviewing
CODEX_LINEAR_REVIEW_PASSED_STATUS=Review Passed

CODEX_LINEAR_DEFAULT_MODEL=gpt-5.5
CODEX_LINEAR_DEFAULT_SANDBOX=danger-full-access
CODEX_LINEAR_CODEX_BIN=codex
# $HOME is expanded by the CLI for path values read from env files.
CODEX_LINEAR_CODEX_CWD=$HOME
CODEX_LINEAR_CODEX_EXEC_MODE=attached

# Omit CODEX_LINEAR_STATE_DIR here so work and review profiles use separate default state dirs.
# Both profiles atomically publish structured usage-limit evidence to this
# shared same-user path. The reset steward reads this file but never trusts
# free-form worker logs.
CODEX_LINEAR_USAGE_LIMIT_EVIDENCE_FILE=$HOME/.local/state/codex-usage-reset-steward/usage-limit-blocked.json
# Used only when CODEX_LINEAR_CODEX_EXEC_MODE=detached.
CODEX_LINEAR_WAIT_TIMEOUT_SECONDS=60
CODEX_LINEAR_LOCK_STALE_SECONDS=600
CODEX_LINEAR_FETCH_LIMIT=50

# Optional. Leave empty to search all visible teams.
CODEX_LINEAR_TEAM_KEY=

# Optional extra static args appended before the prompt.
CODEX_LINEAR_CODEX_EXTRA_ARGS=
